    OPENAI_API_KEY= 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 \
