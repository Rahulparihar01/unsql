# Start with a base image containing Python 3.11
FROM python:3.11

# Create app directory
WORKDIR /

# Install dependencies
COPY requirements.txt .
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y libpq-dev postgresql-client nginx build-essential supervisor && \
    pip install --upgrade pip && \
    pip install -r requirements.txt && \
    pip install gunicorn

# Copy project
COPY . .

# Configure nginx
RUN rm -f /etc/nginx/sites-enabled/default && \
    rm -f /etc/nginx/sites-available/default && \
    rm -f /etc/nginx/conf.d/default.conf && \
    rm -f /etc/nginx/nginx.conf
COPY nginx.conf /etc/nginx/nginx.conf

# Create static directory and set permissions
RUN mkdir -p /apps/static && \
    python manage.py collectstatic --noinput && \
    chown -R www-data:www-data /apps/static

# Expose ports
EXPOSE 80

# Define environment variables
ENV POSTGRES_USER=unsql_admin \
    POSTGRES_PASSWORD=OZpb3Bf4zoTslo \
    POSTGRES_DB=postgres \
    POSTGRES_HOST=unsql-postgres.postgres.database.azure.com \
    ASSETS_ROOT=/static/assets \
    AUTH0_CLIENT_ID=zLNRmKVMfqEbkcqrD7SPAupBYtdD5MEJ \
    AUTH0_CLIENT_SECRET=4LRjSrJkT-LG28o2YwQvia4SpaEQzeYIS6U9-x2I_CPedflhfcES0ITvAAWy2wRQ \
    AUTH0_DOMAIN=auth.unsql.ai \
    AUTH0_MACHINE_ID=wD0m9PYYAg5OvcU0kV1dgngbJYhH7V8v \
    AUTH0_MACHINE_DOMAIN=auth.unsql.ai \
    AUTH0_MACHINE_SECRET=x5ar2VCJgKrOEZVnk_iDKA3Y-tPKgcowuGAT_bNhXqmHkB_0yUUlhPOgw1u2W3nD \
    AUDIENCE=https://auth.unsql.ai/api/v2/ \
